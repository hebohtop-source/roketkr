# MySQL connection string. Use a hosted MySQL provider for Vercel.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Better Auth: use a long random value in Vercel Environment Variables.
BETTER_AUTH_SECRET="replace_with_a_long_random_secret"
NEXT_PUBLIC_BASE_URL="https://your-vercel-domain.vercel.app"

# Optional: Umami website identifier used by the analytics component.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Set to true for a frontend-only Vercel preview without MySQL.
DEMO_MODE="true"