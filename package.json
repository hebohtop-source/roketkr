{
  "name": "nextjs-15",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev --turbopack",
    "prod:build": "docker system prune -f && docker compose down && docker compose up -d --build",
    "docker-dev": "docker compose -f docker-compose.dev.yml up",
    "docker-dev-update": "docker compose -f docker-compose.dev.yml up --build",
    "build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "tscheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "auth:migrate": "bun x auth migrate --config src/lib/auth/server.ts",
    "db:sync-test": "docker exec -t local_postgres pg_dump -U postgres --schema-only roket | docker exec -i local_postgres psql -U postgres rokerkr_test_db",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "bun run src/db/seed.ts && bun run src/db/seed-tags.ts && bun run src/db/seed-categories.ts && bun run src/db/seed-car-models.ts && bun run src/db/seed-products.ts && bun run src/db/seed-promotions.ts && bun run src/db/seed-gallery.ts && bun run src/db/seed-reviews.ts"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.12",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.14.0",
    "mysql2": "^3.22.3",
    "next": "latest",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^8.0.7",
    "radix-ui": "^1.4.3",
    "react": "latest",
    "react-dom": "latest",
    "react-email": "^6.1.4",
    "react-hook-form": "^7.73.1",
    "shadcn": "latest",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "winget": "^0.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.7",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9",
    "eslint-config-next": "^16.2.4",
    "eslint-plugin-react": "latest",
    "postcss": "^8",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "tailwindcss": "^4.2.4",
    "typescript": "latest",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "packageManager": "bun@1.3.14"
}
